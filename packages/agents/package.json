{
  "name": "@creatorai/agents",
  "version": "0.1.0",
  "private": true,
  "description": "AI agents for CreatorAI Studio — each agent is an autonomous content creation capability",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "dev": "tsc --project tsconfig.json --watch",

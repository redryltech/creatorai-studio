    "test:watch": "vitest watch",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@creatorai/shared": "workspace:*",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}

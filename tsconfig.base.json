{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "paths": {
      "@creatorai/shared": ["packages/shared/src"],
      "@creatorai/agents": ["packages/agents/src"],
      "@creatorai/providers": ["packages/providers/src"],
      "@creatorai/database": ["packages/database/src"],
      "@creatorai/orchestrator": ["packages/orchestrator/src"],
      "@creatorai/automation": ["packages/automation/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", "coverage"]
}

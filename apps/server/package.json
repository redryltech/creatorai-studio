{
  "name": "@creatorai/server",
  "version": "0.1.0",
  "private": true,
  "description": "CreatorAI Studio — Express.js API Server",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@creatorai/shared": "workspace:*",
    "@creatorai/agents": "workspace:*",
    "@creatorai/providers": "workspace:*",
    "@creatorai/database": "workspace:*",
    "@creatorai/orchestrator": "workspace:*",
    "@creatorai/automation": "workspace:*",
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^7.4.0",
    "firebase-admin": "^12.3.0",
    "zod": "^3.23.0",
    "dotenv": "^16.4.0",
    "nanoid": "^5.0.0",
    "tsx": "^4.16.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "typescript": "^5.5.0"
  }
}
